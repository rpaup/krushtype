<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">    
    <Style TargetType="TextBlock" x:Key="LogoName">
        <Setter Property="FontFamily" Value="pack://application:,,,/krushtype;component/Fonts/#Inter Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource MainColorBrush}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0.9"/>
        <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1.0"/>
            </Trigger>
        </Style.Triggers>
    </Style>    
    <Style TargetType="TextBlock" x:Key="defaultstyle">
        <Setter Property="FontFamily" Value="pack://application:,,,/krushtype;component/Fonts/#Inter Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColorBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="statisticstyle">
        <Setter Property="Foreground" Value="{DynamicResource TextColorBrush}"/>
        <Setter Property="FontFamily" Value="pack://application:,,,/krushtype;component/Fonts/#Roboto Mono"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="statisticpartstyle">
        <Setter Property="Foreground" Value="{DynamicResource TextColorBrush}"/>
        <Setter Property="FontFamily" Value="pack://application:,,,/krushtype;component/Fonts/#Roboto Mono"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="HorizontalAlignment" Value="left"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="graphstatisticstyle">
        <Setter Property="Foreground" Value="{DynamicResource TextColorBrush}"/>
        <Setter Property="FontFamily" Value="pack://application:,,,/krushtype;component/Fonts/#Roboto Mono"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="InputText">
        <Setter Property="Foreground" Value="{DynamicResource SubColorBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="MainTestResults">
        <Setter Property="Foreground" Value="{DynamicResource MainColorBrush}"/>
        <Setter Property="FontSize" Value="50"/>
        <Setter Property="FontFamily" Value="pack://application:,,,/krushtype;component/Fonts/#Roboto Mono"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Opacity" Value="0.95"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBlock" x:Key="OtherTestResults">
        <Setter Property="Foreground" Value="{DynamicResource MainColorBrush}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontFamily" Value="pack://application:,,,/krushtype;component/Fonts/#Roboto Mono"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Opacity" Value="0.9"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBlock" x:Key="TextTestResults">
        <Setter Property="Foreground" Value="{DynamicResource SubColorBrush}"/>
        <Setter Property="FontFamily" Value="pack://application:,,,/krushtype;component/Fonts/#Roboto Mono"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Opacity" Value="0.8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBlock" x:Key="textstyle">
        <Setter Property="FontFamily" Value="pack://application:,,,/krushtype;component/Fonts/#Inter Regular"/>
        <Setter Property="Foreground" Value="{DynamicResource SubColorBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="typingstyle">
        <Setter Property="FontFamily" Value="pack://application:,,,/krushtype;component/Fonts/#Roboto"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColorBrush}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="false_type">
        <Setter Property="FontFamily" Value="pack://application:,,,/krushtype;component/Fonts/#Roboto"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorColorBrush}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="accstyle">
        <Setter Property="FontFamily" Value="pack://application:,,,/krushtype;component/Fonts/#Inter Regular"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColorBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="resultstyle">
        <Setter Property="FontFamily" Value="pack://application:,,,/krushtype;component/Fonts/#Roboto Mono"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColorBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="desc_style">
        <Setter Property="FontFamily" Value="pack://application:,,,/krushtype;component/Fonts/#Inter Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource SubColorBrush}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>