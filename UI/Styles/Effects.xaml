<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DropShadowEffect x:Key="SoftShadowEffect" 
                     ShadowDepth="2" 
                     BlurRadius="10" 
                     Color="#40000000" 
                     Opacity="0.3" 
                     Direction="270"/>
    
    <DropShadowEffect x:Key="HoverShadowEffect" 
                     ShadowDepth="0" 
                     BlurRadius="12" 
                     Color="#40000000" 
                     Opacity="0.5"/>
    
    <DropShadowEffect x:Key="StrongShadowEffect" 
                     ShadowDepth="4" 
                     BlurRadius="15" 
                     Color="#40000000" 
                     Opacity="0.5" 
                     Direction="270"/>
</ResourceDictionary> 