<UserControl x:Class="krushtype.UI.Views.TestResults"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:krushtype.UI.Views"
             xmlns:uc="clr-namespace:krushtype.UI.UserControls"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="oxy:TrackerControl">
            <Setter Property="LineStroke" Value="Transparent"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  
            <RowDefinition Height="*"/>      
            <RowDefinition Height="Auto"/>  
            <RowDefinition Height="Auto"/>  
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="1" Grid.Column="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" 
                        Orientation="Vertical"
                        VerticalAlignment="Top"
                        Margin="0,0,0,10">
                <TextBlock Text="words per minute" 
                          Style="{StaticResource TextTestResults}"
                          FontSize="20"/>
                <TextBlock Text="{Binding WPM, StringFormat={}{0:F0}}"
                          Style="{StaticResource MainTestResults}"
                          FontSize="60"/>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Vertical"
                        VerticalAlignment="Top"
                        Margin="0,10,0,0">
                <TextBlock Text="accuracy" 
                          Style="{StaticResource TextTestResults}"
                          FontSize="20"/>
                <TextBlock Text="{Binding Accuracy, StringFormat={}{0:F0}%}"
                          Style="{StaticResource MainTestResults}"
                          FontSize="60"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" Margin="20,20,20,10" CornerRadius="8" Background="{DynamicResource SubAltColorBrush}">
                <oxy:PlotView Model="{Binding scatterModel}"
                           Background="Transparent"
                           Controller="{Binding customController}" Margin="5"/>
            </Border>
            
            <Grid Grid.Row="1" Margin="20,0,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="5,0" HorizontalAlignment="Center">
                    <TextBlock Text="raw wpm" 
                              Style="{StaticResource TextTestResults}"
                               HorizontalAlignment="Center"
                              FontSize="16"/>
                    <TextBlock Text="{Binding RawWPM, StringFormat={}{0:F0}}"
                              Style="{StaticResource OtherTestResults}"
                               HorizontalAlignment="Center"
                              FontSize="28"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5,0" HorizontalAlignment="Center">
                    <TextBlock Text="characters" 
                              Style="{StaticResource TextTestResults}"
                               HorizontalAlignment="Center"
                              FontSize="16"/>
                    <TextBlock Text="{Binding Chars}"
                              Style="{StaticResource OtherTestResults}"
                               HorizontalAlignment="Center"
                              FontSize="28"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5,0" HorizontalAlignment="Center">
                    <TextBlock Text="consistency" 
                              Style="{StaticResource TextTestResults}"
                               HorizontalAlignment="Center"
                              FontSize="16"/>
                    <TextBlock Text="{Binding Consistency, StringFormat={}{0:F0}%}"
                               HorizontalAlignment="Center"
                              Style="{StaticResource OtherTestResults}"
                              FontSize="28"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="5,0" HorizontalAlignment="Center">
                    <TextBlock Text="time" 
                              Style="{StaticResource TextTestResults}"
                               HorizontalAlignment="Center"
                              FontSize="16"/>
                    <TextBlock Text="{Binding NumTime, StringFormat={}{0:F0}s}"
                              Style="{StaticResource OtherTestResults}"
                               HorizontalAlignment="Center"
                              FontSize="28"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>

        <StackPanel Grid.Row="2" Grid.Column="0"
                    Orientation="Horizontal" 
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="20,5,0,10">
            <TextBlock Text="{Binding TestType}"
                     Foreground="{DynamicResource TextMediumColorBrush}"
                     FontSize="14"
                     Margin="0,0,5,0"/>
            <TextBlock Text="/"
                     Foreground="{DynamicResource TextMediumColorBrush}"
                     FontSize="14"
                     VerticalAlignment="Center"
                     Margin="0,0,5,0"/>
            <TextBlock Text="{Binding Language}"
                     Foreground="{DynamicResource TextMediumColorBrush}" 
                     FontSize="14"/>
        </StackPanel>

        <Border Grid.Row="3" Grid.Column="1"
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom"
                Background="{DynamicResource BgColorBrush}"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource SubAltColorBrush}"
                Padding="2"
                Margin="0,0,20,20">
            <Button Content="next test ᐳ"
                    x:Name="NextTestButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource TextMediumColorBrush}"
                    FontSize="15"
                    Height="34"
                    Padding="16,0"
                    Cursor="Hand"
                    FontFamily="pack://application:,,,/krushtype;component/Fonts/#Roboto Mono"
                    Command="{Binding NextTestCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid MinWidth="{TemplateBinding Width}">
                                        <Border x:Name="Border" 
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter x:Name="ContentPresenter"
                                                            HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#15FFFFFF"/>
                                            <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource TextColorBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#25FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Border>
    </Grid>
</UserControl>
