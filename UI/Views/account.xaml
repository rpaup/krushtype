<UserControl x:Class="krushtype.UI.Views.account"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"             
             xmlns:vm="clr-namespace:krushtype.Core.ViewModels"
             xmlns:oxy="http://oxyplot.org/wpf"             
             xmlns:uc="clr-namespace:krushtype.UI.UserControls"
             xmlns:cvtr="clr-namespace:krushtype.Core.Utilities.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="1800" d:DesignWidth="920"
             BorderThickness="0">
    <UserControl.Resources>
        <Style TargetType="oxy:TrackerControl">
            <Setter Property="LineStroke" Value="Transparent"/>
        </Style>
        <cvtr:IsRecordConverter x:Key="IsRecordConverter"/>
        
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColorBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubAltColorBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="10" Opacity="0.15" Direction="270" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
        <Grid MaxWidth="1200" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
            </Grid.RowDefinitions>
            
            <Border Style="{StaticResource CardBorderStyle}" Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/> 
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center">
                        <Border Width="90" 
                                Height="90" 
                                CornerRadius="45" 
                                BorderBrush="{DynamicResource MainColorBrush}" 
                                BorderThickness="2">
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/images/account_icon.png" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        
                        <StackPanel Margin="18,0,0,0" 
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayNickName}"
                                       FontSize="24" 
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource MainColorBrush}"
                                       Margin="0,0,0,5"/>
                            
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="member since "
                                           FontSize="13"
                                           Foreground="{DynamicResource TextColorBrush}"/>
                                <TextBlock Text="{Binding DisplayCreateAccount}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextColorBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    
                    <Button Grid.Column="1" 
                            Width="120"
                            Height="40"
                                Command="{Binding LogoutCommand}"
                            Cursor="Hand"
                            Margin="10,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource SubAltColorBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextColorBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal" 
                                                                    HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="⎋" 
                                                                       FontSize="18"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,4,0"/> 
                                                            
                                                            <TextBlock Text="logout" 
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ErrorColorBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#CC2E2E"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect ShadowDepth="1" 
                                                                          BlurRadius="4" 
                                                                          Opacity="0.2" 
                                                                          Direction="270"/>
                                                    </Setter.Value>
                                                </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                    </Style>
                                </Style.Resources>
                                </Style>
                            </Button.Style>
                        </Button>
                </Grid>
            </Border>
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Style="{StaticResource CardBorderStyle}" Grid.Column="0">
                    <DockPanel>
                        <TextBlock Text="time records" 
                                   Style="{StaticResource SectionHeaderStyle}"
                                   DockPanel.Dock="Top"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <uc:RecordsInfo
                                     DataContext="{Binding RecordTests.Time15}"
                                        Mode="{Binding Mode}"
                                        WPM="{Binding WPM}"
                                        RawWPM="{Binding RawWPM}"
                                        Accurancy="{Binding Accuracy}"
                                        Сonsistency="{Binding Consistency}"
                                        Date="{Binding Date}"/>
                        <uc:RecordsInfo
                                     DataContext="{Binding RecordTests.Time30}"
                                        Mode="{Binding Mode}"
                                        WPM="{Binding WPM}"
                                        RawWPM="{Binding RawWPM}"
                                        Accurancy="{Binding Accuracy}"
                                        Сonsistency="{Binding Consistency}"
                                        Date="{Binding Date}"/>
                        <uc:RecordsInfo
                                     DataContext="{Binding RecordTests.Time60}"
                                        Mode="{Binding Mode}"
                                        WPM="{Binding WPM}"
                                        RawWPM="{Binding RawWPM}"
                                        Accurancy="{Binding Accuracy}"
                                        Сonsistency="{Binding Consistency}"
                                        Date="{Binding Date}"/>
                        <uc:RecordsInfo
                                     DataContext="{Binding RecordTests.Time120}"
                                        Mode="{Binding Mode}"
                                        WPM="{Binding WPM}"
                                        RawWPM="{Binding RawWPM}"
                                        Accurancy="{Binding Accuracy}"
                                        Сonsistency="{Binding Consistency}"
                                        Date="{Binding Date}"/>
                    </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                
                <Border Style="{StaticResource CardBorderStyle}" Grid.Column="1">
                    <DockPanel>
                        <TextBlock Text="word records" 
                                   Style="{StaticResource SectionHeaderStyle}"
                                   DockPanel.Dock="Top"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <uc:RecordsInfo
                                     DataContext="{Binding RecordTests.Words10}"
                                        Mode="{Binding Mode}"
                                        WPM="{Binding WPM}"
                                        RawWPM="{Binding RawWPM}"
                                        Accurancy="{Binding Accuracy}"
                                        Сonsistency="{Binding Consistency}"
                                        Date="{Binding Date}"/>
                        <uc:RecordsInfo
                                     DataContext="{Binding RecordTests.Words25}"
                                        Mode="{Binding Mode}"
                                        WPM="{Binding WPM}"
                                        RawWPM="{Binding RawWPM}"
                                        Accurancy="{Binding Accuracy}"
                                        Сonsistency="{Binding Consistency}"
                                        Date="{Binding Date}"/>
                        <uc:RecordsInfo
                                     DataContext="{Binding RecordTests.Words50}"
                                        Mode="{Binding Mode}"
                                        WPM="{Binding WPM}"
                                        RawWPM="{Binding RawWPM}"
                                        Accurancy="{Binding Accuracy}"
                                        Сonsistency="{Binding Consistency}"
                                        Date="{Binding Date}"/>
                        <uc:RecordsInfo
                                     DataContext="{Binding RecordTests.Words100}"
                                        Mode="{Binding Mode}"
                                        WPM="{Binding WPM}"
                                        RawWPM="{Binding RawWPM}"
                                        Accurancy="{Binding Accuracy}"
                                        Сonsistency="{Binding Consistency}"
                                        Date="{Binding Date}"/>
                    </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            
            <Border Style="{StaticResource CardBorderStyle}" Grid.Row="2">
                <DockPanel>
                    <TextBlock Text="detailed statistics" 
                               Style="{StaticResource SectionHeaderStyle}"
                               DockPanel.Dock="Top"/>
                    <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                        <Border Background="{DynamicResource SubAltColorBrush}" 
                                CornerRadius="8" 
                                Margin="5"
                                Padding="15,10"
                                Grid.Column="0" Grid.Row="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="test statistics" 
                                           FontWeight="Medium"
                                           FontSize="18"
                                           Grid.ColumnSpan="2"
                                           Margin="0,0,0,10"
                                           Foreground="{DynamicResource MainColorBrush}"/>
                                           
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,5,10,5">
                    <TextBlock Text="tests started"
                               Style="{StaticResource defaultstyle}"/>
                    <TextBlock Text="{Binding DisplayTestsStarted}"
                               Style="{StaticResource statisticpartstyle}"/>
                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,5,0,5">
                    <TextBlock Text="tests completed"
                               Style="{StaticResource defaultstyle}"
                               HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayTestsCompleted}" 
                                   Style="{StaticResource statisticstyle}"/>
                        <TextBlock Text="{Binding DisplayTestCompletedPerStarted,StringFormat={}({0}%)}" 
                                   Style="{StaticResource statisticstyle}"/>
                    </StackPanel>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,5,10,5">
                                    <TextBlock Text="words typed"
                                               Style="{StaticResource defaultstyle}"/>
                                    <TextBlock Text="{Binding DisplayWordsTyped}"
                                               Style="{StaticResource statisticpartstyle}"/>
                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,5,0,5">
                    <TextBlock Text="time typing"
                               Style="{StaticResource defaultstyle}"
                               HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding DisplayTimeTyping}"
                               Style="{StaticResource statisticpartstyle}"/>
                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource SubAltColorBrush}" 
                                CornerRadius="8" 
                                Margin="5"
                                Padding="15,10"
                                Grid.Column="1" Grid.Row="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="wpm statistics" 
                                           FontWeight="Medium"
                                           FontSize="18"
                                           Grid.ColumnSpan="2"
                                           Margin="0,0,0,10"
                                           Foreground="{DynamicResource MainColorBrush}"/>
                                           
                                <StackPanel Grid.Row="1" Grid.Column="0" 
                                            Margin="0,5,10,5"
                                            DataContext="{Binding DisplayMaxTestWPM}">
                    <TextBlock Text="highest wpm"
                               Style="{StaticResource defaultstyle}"/>
                    <TextBlock Text="{Binding WPM, StringFormat={}{0:0}}"
                               Style="{StaticResource statisticpartstyle}"/>
                    <TextBlock Text="{Binding Mode}"
                               Style="{StaticResource statisticpartstyle}"
                               FontSize="12"/>
                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,5,0,5">
                    <TextBlock Text="average wpm"
                               Style="{StaticResource defaultstyle}"/>
                    <TextBlock Text="{Binding DisplayAverageWPM, StringFormat={}{0:0}}"
                               Style="{StaticResource statisticpartstyle}"/>
                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,5,10,5">
                    <TextBlock Text="highest raw wpm"
                               Style="{StaticResource defaultstyle}"/>
                    <TextBlock Text="{Binding DisplayHighestRawWPM, StringFormat={}{0:0}}"
                               Style="{StaticResource statisticpartstyle}"/>
                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,5,0,5">
                    <TextBlock Text="average raw wpm"
                               Style="{StaticResource defaultstyle}"/>
                    <TextBlock Text="{Binding DisplayAverageRawWPM, StringFormat={}{0:0}}"
                               Style="{StaticResource statisticpartstyle}"/>
                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource SubAltColorBrush}" 
                                CornerRadius="8" 
                                Margin="5"
                                Padding="15,10"
                                Grid.Column="0" Grid.Row="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="accuracy statistics" 
                                           FontWeight="Medium"
                                           FontSize="18"
                                           Grid.ColumnSpan="2"
                                           Margin="0,0,0,10"
                                           Foreground="{DynamicResource MainColorBrush}"/>
                                           
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,5,10,5">
                    <TextBlock Text="highest accuracy"
                               Style="{StaticResource defaultstyle}"/>
                    <TextBlock Text="{Binding DisplayHighestAccuracy, StringFormat={}{0:0}%}"
                               Style="{StaticResource statisticpartstyle}"/>
                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,5,0,5">
                    <TextBlock Text="average accuracy"
                               Style="{StaticResource defaultstyle}"/>
                    <TextBlock Text="{Binding DisplayAverageAccuracy, StringFormat={}{0:0}%}"
                               Style="{StaticResource statisticpartstyle}"/>
                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" 
                                            Grid.ColumnSpan="2"
                                            Margin="0,5,0,5">
                                    <TextBlock Text="average accuracy (last 10 tests)"
                               Style="{StaticResource defaultstyle}"/>
                    <TextBlock Text="{Binding DisplayAvgAcc10lastTests, StringFormat={}{0:0}%}"
                               Style="{StaticResource statisticpartstyle}"/>
                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource SubAltColorBrush}" 
                                CornerRadius="8" 
                                Margin="5"
                                Padding="15,10"
                                Grid.Column="1" Grid.Row="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="consistency statistics" 
                                           FontWeight="Medium"
                                           FontSize="18"
                                           Grid.ColumnSpan="2"
                                           Margin="0,0,0,10"
                                           Foreground="{DynamicResource MainColorBrush}"/>
                                           
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,5,10,5">
                    <TextBlock Text="highest consistency"
                               Style="{StaticResource defaultstyle}"/>
                    <TextBlock Text="{Binding DisplayHighestConsistency, StringFormat={}{0:0}%}"
                               Style="{StaticResource statisticpartstyle}"/>
                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,5,0,5">
                                    <TextBlock Text="average consistency"
                               Style="{StaticResource defaultstyle}"/>
                    <TextBlock Text="{Binding DisplayAverageConsistency, StringFormat={}{0:0}%}"
                               Style="{StaticResource statisticpartstyle}"/>
                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" 
                                            Grid.ColumnSpan="2"
                                            Margin="0,5,0,5">
                                    <TextBlock Text="average consistency (last 10 tests)"
                               Style="{StaticResource defaultstyle}"/>
                    <TextBlock Text="{Binding DisplayAvgCon10lastTests, StringFormat={}{0:0}%}"
                               Style="{StaticResource statisticpartstyle}"/>
                </StackPanel>
                            </Grid>
                        </Border>
            </Grid>
                </DockPanel>
            </Border>
            
            <Border Style="{StaticResource CardBorderStyle}" Grid.Row="3">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="recent activity"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Grid.Column="0"/>
</Grid>
                    
                    <DataGrid Style="{StaticResource Last10Tests}"
                              ItemsSource="{Binding Last10Tests}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Width="30" Binding="{Binding IsRecord, Converter={StaticResource IsRecordConverter}}" CanUserSort="False" />
                            <DataGridTextColumn Header="wpm" Width="70" Binding="{Binding WPM}"/>
                            <DataGridTextColumn Header="raw" Width="70" Binding="{Binding RawWPM}"/>
                            <DataGridTextColumn Header="accuracy" Width="80" Binding="{Binding Accuracy}"/>
                            <DataGridTextColumn Header="consistency" Width="110" Binding="{Binding Consistency}"/>
                            <DataGridTextColumn Header="chars" Width="100" Binding="{Binding Chars}" CanUserSort="False"/>
                            <DataGridTextColumn Header="mode" Width="80" Binding="{Binding Mode}" CanUserSort="False"/>
                            <DataGridTextColumn Header="language" Width="100" Binding="{Binding Language}" CanUserSort="False"/>
                            <DataGridTextColumn Header="date" Width="200" Binding="{Binding Date, StringFormat={}{0:dd MMMM yyyy HH:mm:ss}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
