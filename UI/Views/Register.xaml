<UserControl x:Class="krushtype.UI.Views.Register"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:krushtype.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="920">

    <Grid>
        <Border Width="450" 
                Height="600"
                Background="#2c2e31"
                CornerRadius="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" 
                            VerticalAlignment="Center">
                    <Image Source="/Assets/images/icon.png" 
                           Height="50" 
                           Width="50" 
                           Margin="0,0,0,5"/>
                    <TextBlock Text="Create Account" 
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" 
                            Margin="40,10">
                    <TextBlock Text="Username" 
                               FontSize="14"
                               Foreground="#b4b5b8"
                               Margin="0,0,0,5"/>
                    <Border Background="#323437"
                            CornerRadius="5"
                            Margin="0,0,0,12">
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="10,8"
                                 Height="40"/>
                    </Border>

                    <TextBlock Text="Email" 
                               FontSize="14"
                               Foreground="#b4b5b8"
                               Margin="0,0,0,5"/>
                    <Border Background="#323437"
                            CornerRadius="5"
                            Margin="0,0,0,12">
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="10,8"
                                 Height="40"/>
                    </Border>

                    <TextBlock Text="Password" 
                               FontSize="14"
                               Foreground="#b4b5b8"
                               Margin="0,0,0,5"/>
                    <Border Background="#323437"
                            CornerRadius="5"
                            Margin="0,0,0,12">
                        <PasswordBox Name="PasswordBox"
                                     FontSize="14"
                                     Foreground="White"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Padding="10,8"
                                     Height="40"/>
                    </Border>

                    <TextBlock Text="Confirm Password" 
                               FontSize="14"
                               Foreground="#b4b5b8"
                               Margin="0,0,0,5"/>
                    <Border Background="#323437"
                            CornerRadius="5"
                            Margin="0,0,0,12">
                        <PasswordBox Name="ConfirmPasswordBox"
                                     FontSize="14"
                                     Foreground="White"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Padding="10,8"
                                     Height="40"/>
                    </Border>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#e2b714"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <Button Command="{Binding RegisterCommand}"
                            Content="Create Account"
                            FontSize="14"
                            Foreground="White"
                            Background="#e2b714"
                            BorderThickness="0"
                            Padding="0,8"
                            Height="40"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#e2b714"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#cea912"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Margin="0,15,0,0">
                        <TextBlock Text="Creating account..." 
                                   FontSize="14"
                                   Foreground="#b4b5b8"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </StackPanel>                
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Already have an account? " 
                               FontSize="14"
                               Foreground="#b4b5b8"/>                    <Button Content="Login"
                            Command="{Binding GoToLoginCommand}"
                            FontSize="14"
                            Foreground="#e2b714"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="LoginButton_Click"
                            Margin="5,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
