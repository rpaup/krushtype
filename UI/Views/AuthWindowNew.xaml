<Window x:Class="krushtype.UI.Views.AuthWindowNew"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:krushtype.UI.Views"
        xmlns:controls="clr-namespace:krushtype.UI.UserControls"
        mc:Ignorable="d"
        Height="520" Width="460"
        MinHeight="480" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColorBrush}"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/krushtype;component/UI/Styles/ThemeColors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Duration x:Key="AnimationDuration">0:0:0.25</Duration>

            <Style x:Key="KrushtypeTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextColorBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource CaretColorBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border"
                                    Background="{DynamicResource SubAltColorBrush}" 
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SubColorBrush}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" 
                                             Margin="{TemplateBinding Padding}"
                                             VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource MainColorBrush}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource MainColorBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="KrushtypePasswordBox" TargetType="PasswordBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextColorBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource CaretColorBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="border"
                                    Background="{DynamicResource SubAltColorBrush}" 
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SubColorBrush}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" 
                                             Margin="{TemplateBinding Padding}"
                                             VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource MainColorBrush}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource MainColorBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="KrushtypeButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource MainColorBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource BgColorBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                   Background="{TemplateBinding Background}"
                                   BorderThickness="{TemplateBinding BorderThickness}"
                                   CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" TargetName="border" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" TargetName="border" Value="0.8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" TargetName="border" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TextLinkButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource MainColorBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="contentPresenter"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="TextElement.FontWeight" TargetName="contentPresenter" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextColorBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style x:Key="WindowControlButton" TargetType="Button">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="buttonBorder"
                                   Background="{TemplateBinding Background}"
                                   CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="buttonBorder" Value="{DynamicResource SubAltColorBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" TargetName="buttonBorder" Value="{DynamicResource SubColorBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PasswordStrengthIndicator" TargetType="Border">
                <Setter Property="Height" Value="4"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
            </Style>
            
            <Style x:Key="PasswordRequirementItem" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource SubColorBrush}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
        
        <Grid>
            <Grid.RowDefinitions>
            <RowDefinition Height="40"/> 
                <RowDefinition Height="*"/> 
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                           Orientation="Horizontal"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                       Margin="16,0,0,0">
                    <TextBlock Text="krushtype"
                              Foreground="{DynamicResource MainColorBrush}"
                          FontSize="20"
                              FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right"
                       Margin="0,0,8,0">
                    <Button x:Name="btnMinimize"
                           Style="{StaticResource WindowControlButton}"
                       Margin="0,0,6,0"
                           Click="BtnMinimize_Click">
                        <Path Data="M0,0 L10,0" 
                             Stroke="{DynamicResource TextColorBrush}"
                             StrokeThickness="1.5"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="btnClose"
                           Style="{StaticResource WindowControlButton}"
                           Click="BtnClose_Click">
                        <Path Data="M0,0 L8,8 M8,0 L0,8"
                             Stroke="{DynamicResource TextColorBrush}"
                             StrokeThickness="1.5"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

        <Grid Grid.Row="1" Margin="24,0">
                    <Grid x:Name="loginView" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="1" 
                                   Width="320"
                                   VerticalAlignment="Center">
                    <TextBlock Text="login" 
                                      FontSize="28" 
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextColorBrush}"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,32"/>
                            
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="username" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="txtLoginUsernameError" 
                                          Grid.Column="1"
                                          Margin="5,0,0,6"
                                          Foreground="{DynamicResource ErrorColorBrush}"
                                          FontSize="11"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Visibility="Collapsed"/>
                            </Grid>
                            <TextBox x:Name="txtLoginUsername"
                                    Style="{StaticResource KrushtypeTextBox}"
                                    VerticalContentAlignment="Center"
                                    Margin="0,0,0,16"
                                    TextChanged="TxtLoginUsername_TextChanged"/>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="password" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="txtLoginPasswordError" 
                                          Grid.Column="1"
                                          Margin="5,0,0,6"
                                          Foreground="{DynamicResource ErrorColorBrush}"
                                          FontSize="11"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Visibility="Collapsed"/>
                                <Button Grid.Column="2"
                                       x:Name="btnToggleLoginPassword"
                                       Content="show"
                                       Foreground="{DynamicResource MainColorBrush}"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       Padding="4,0"
                                       Cursor="Hand"
                                       Click="BtnToggleLoginPassword_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,24">
                                <PasswordBox x:Name="pwdLoginPassword"
                                            Style="{StaticResource KrushtypePasswordBox}"
                                            VerticalContentAlignment="Center"
                                            PasswordChanged="PwdLoginPassword_PasswordChanged"/>
                                
                                <TextBox x:Name="txtLoginPasswordVisible"
                                        Style="{StaticResource KrushtypeTextBox}"
                                        VerticalContentAlignment="Center"
                                        Visibility="Collapsed"
                                        TextChanged="TxtLoginPasswordVisible_TextChanged"/>
                            </Grid>

                            <TextBlock x:Name="txtLoginError"
                                      Foreground="{DynamicResource ErrorColorBrush}"
                                      TextWrapping="Wrap"
                                      Margin="0,0,0,16"
                                      Visibility="Collapsed"/>

                            <Button x:Name="btnLogin"
                           Content="login"
                                   Style="{StaticResource KrushtypeButton}"
                                   Click="BtnLogin_Click"/>

                            <StackPanel Orientation="Horizontal"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,0">
                        <TextBlock Text="don't have an account? "
                                          Foreground="{DynamicResource SubColorBrush}"/>
                        <Button Content="register"
                                       Style="{StaticResource TextLinkButton}"
                                       Click="BtnShowRegister_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="registerView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="1"
                                   Width="320"
                                   VerticalAlignment="Center">
                    <TextBlock Text="register"
                                      FontSize="28"
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextColorBrush}"
                                      HorizontalAlignment="Center"
                              Margin="0,0,0,24"/>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="username" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="txtRegisterUsernameError" 
                                         Grid.Column="1"
                                         Margin="5,0,0,6"
                                         Foreground="{DynamicResource ErrorColorBrush}"
                                         FontSize="11"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Left"
                                         Visibility="Collapsed"/>
                            </Grid>
                            <TextBox x:Name="txtRegisterUsername"
                                    Style="{StaticResource KrushtypeTextBox}"
                                    VerticalContentAlignment="Center"
                                    Margin="0,0,0,16"
                                    TextChanged="TxtRegisterUsername_TextChanged"/>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="password" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="txtRegisterPasswordError" 
                                         Grid.Column="1"
                                         Margin="5,0,0,6"
                                         Foreground="{DynamicResource ErrorColorBrush}"
                                         FontSize="11"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Left"
                                         Visibility="Collapsed"/>
                                <Button Grid.Column="2"
                                       x:Name="btnToggleRegisterPassword"
                                       Content="show"
                                       Foreground="{DynamicResource MainColorBrush}"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       Padding="4,0"
                                       Cursor="Hand"
                                       Click="BtnToggleRegisterPassword_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <PasswordBox x:Name="pwdRegisterPassword"
                                            Style="{StaticResource KrushtypePasswordBox}"
                                            VerticalContentAlignment="Center"
                                            PasswordChanged="PwdRegisterPassword_PasswordChanged"/>
                                
                                <TextBox x:Name="txtRegisterPasswordVisible"
                                        Style="{StaticResource KrushtypeTextBox}"
                                        VerticalContentAlignment="Center"
                                        Visibility="Collapsed"
                                        TextChanged="TxtRegisterPasswordVisible_TextChanged"/>
                            </Grid>

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border x:Name="strengthIndicator1"
                                       Grid.Column="0"
                                       Style="{StaticResource PasswordStrengthIndicator}"
                                       Background="{DynamicResource SubColorBrush}"/>
                                
                                <Border x:Name="strengthIndicator2"
                                       Grid.Column="1"
                                       Style="{StaticResource PasswordStrengthIndicator}"
                                       Background="{DynamicResource SubColorBrush}"/>
                                
                                <Border x:Name="strengthIndicator3"
                                       Grid.Column="2"
                                       Style="{StaticResource PasswordStrengthIndicator}"
                                       Background="{DynamicResource SubColorBrush}"/>
                                
                                <Border x:Name="strengthIndicator4"
                                       Grid.Column="3"
                                       Style="{StaticResource PasswordStrengthIndicator}"
                                       Background="{DynamicResource SubColorBrush}"/>
                            </Grid>

                            <TextBlock x:Name="txtPasswordStrength"
                              Text="password strength"
                                      Foreground="{DynamicResource SubColorBrush}"
                                      FontSize="12"
                              Margin="0,0,0,8"/>
                    
                    <Border Background="{DynamicResource SubAltColorBrush}" 
                            CornerRadius="6" 
                            Padding="12,10" 
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="password requirements:" 
                                      FontWeight="Medium"
                                      Foreground="{DynamicResource TextColorBrush}"
                                      Margin="0,0,0,6"/>
                            
                            <TextBlock x:Name="reqLength" Style="{StaticResource PasswordRequirementItem}">
                                <Run x:Name="iconLength" Text="○"/>
                                <Run Text=" minimum 8 characters"/>
                            </TextBlock>
                            
                            <TextBlock x:Name="reqDigit" Style="{StaticResource PasswordRequirementItem}">
                                <Run x:Name="iconDigit" Text="○"/>
                                <Run Text=" minimum 1 digit"/>
                            </TextBlock>
                            
                            <TextBlock x:Name="reqUpper" Style="{StaticResource PasswordRequirementItem}">
                                <Run x:Name="iconUpper" Text="○"/>
                                <Run Text=" minimum 1 uppercase letter"/>
                            </TextBlock>
                            
                            <TextBlock x:Name="reqSpecial" Style="{StaticResource PasswordRequirementItem}">
                                <Run x:Name="iconSpecial" Text="○"/>
                                <Run Text=" minimum 1 special character"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                            <TextBlock x:Name="txtRegisterError"
                                      Foreground="{DynamicResource ErrorColorBrush}"
                                      TextWrapping="Wrap"
                                      Margin="0,0,0,16"
                                      Visibility="Collapsed"/>

                            <Button x:Name="btnRegister"
                           Content="register"
                                   Style="{StaticResource KrushtypeButton}"
                                   Click="BtnRegister_Click"/>

                            <StackPanel Orientation="Horizontal"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,0">
                        <TextBlock Text="already have an account? "
                                          Foreground="{DynamicResource SubColorBrush}"/>
                        <Button Content="login"
                                       Style="{StaticResource TextLinkButton}"
                                       Click="BtnShowLogin_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
</Window>
