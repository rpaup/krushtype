<UserControl x:Class="krushtype.UI.Views.typing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:krushtype.UI.Views"
             xmlns:vm="clr-namespace:krushtype.Core.ViewModels"
             xmlns:Menu="clr-namespace:krushtype.Core.Utilities"
             xmlns:uc="clr-namespace:krushtype.UI.UserControls"
             xmlns:converters="clr-namespace:krushtype.Core.Utilities.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="525" d:DesignWidth="920">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToBooleanConverter x:Key="StringToBooleanConverter"/>
    </UserControl.Resources>
    <Grid>
        <Border Background="Transparent" 
                Width="800" 
                Height="40"
                VerticalAlignment="Top"
                Margin="0,25,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TypingSettingsVisibility}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            
            <Grid Width="800" HorizontalAlignment="Center">
                <Border Background="{DynamicResource BgColorBrush}"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SubAltColorBrush}"
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0">
                        <Grid Width="210" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="5,0" HorizontalAlignment="Center">
                                <CheckBox Content="@ punctuation"
                                        Style="{StaticResource selecttypingelements}"
                                        IsChecked="{Binding AddPunctuationProperty, Mode=TwoWay}"
                                        Margin="0,0,20,0"/>
                                
                                <CheckBox Content="# numbers"
                                        Style="{StaticResource selecttypingelements}"
                                        IsChecked="{Binding AddNumbersProperty, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                        
                        <Border Width="1"
                                Height="18"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SubColorBrush}"
                                Opacity="0.3"
                                Margin="5,0"/>
                        
                        <Grid Width="145" VerticalAlignment="Center">
                            <Border Height="34"
                                    CornerRadius="6"
                                    Margin="5,0"
                                    x:Name="LanguageSelector"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#15FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="🌐" 
                                               Grid.Column="0"
                                               Margin="8,0,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextColorBrush}"
                                               Opacity="0.7"
                                               FontSize="14"/>
                                    
                                    <TextBlock Grid.Column="1"
                                              Text="{Binding SelectedDisplayLanguage}"
                                              Foreground="{DynamicResource TextColorBrush}"
                                              FontFamily="Consolas"
                                              FontSize="14"
                                              VerticalAlignment="Center"
                                              Margin="0,0,0,0"/>
                                    
                                    <Path Grid.Column="2" 
                                          Data="M0,0 L6,0 L3,3 Z" 
                                          Fill="{DynamicResource TextColorBrush}" 
                                          Opacity="0.7"
                                          Margin="8,0,8,0"
                                          VerticalAlignment="Center"/>
                
                                    <Button Grid.ColumnSpan="3" 
                                            Background="Transparent" 
                                            BorderThickness="0" 
                                            Opacity="0"
                                            Click="LanguageSelector_Click"
                                            Cursor="Hand"
                                            ToolTip="Select typing language"/>
                                </Grid>
                            </Border>
                        </Grid>
                        
                        <Border Width="1"
                                Height="18"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SubColorBrush}"
                                Opacity="0.3"
                                Margin="5,0"/>
                        
                        <Grid Width="140" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0" HorizontalAlignment="Center">
                                <RadioButton Content="🕓 time"
                                            Style="{StaticResource selectformtyping}"
                                            Margin="0,0,20,0"
                                            IsChecked="{Binding Path=TypingType, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='time', Mode=OneWay}"
                                            Command="{Binding ChangeTypingFormCommand}"
                                            CommandParameter="time"/>
                                
                                <RadioButton Content="𝐀 words"
                                            Style="{StaticResource selectformtyping}"
                                            IsChecked="{Binding Path=TypingType, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='words', Mode=OneWay}"
                                            Command="{Binding ChangeTypingFormCommand}"
                                            CommandParameter="words"/>
                            </StackPanel>
                        </Grid>
                        
                        <Border Width="1"
                                Height="18"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SubColorBrush}"
                                Opacity="0.3"
                                Margin="5,0"/>
                        
                        <Grid Width="250" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0">
                                <RadioButton Content="{Binding DisplayTypingParameter_1}"
                                            Style="{StaticResource selectformtyping}"
                                            Margin="0,0,8,0"
                                            IsChecked="{Binding IsParameter1Selected, Mode=OneWay}"
                                            Command="{Binding ChangeTypingParameterCommand}"
                                            CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                                
                                <RadioButton Content="{Binding DisplayTypingParameter_2}"
                                            Style="{StaticResource selectformtyping}"
                                            Margin="0,0,8,0"
                                            IsChecked="{Binding IsParameter2Selected, Mode=OneWay}"
                                            Command="{Binding ChangeTypingParameterCommand}"
                                            CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                                
                                <RadioButton Content="{Binding DisplayTypingParameter_3}"
                                            Style="{StaticResource selectformtyping}"
                                            Margin="0,0,8,0"
                                            IsChecked="{Binding IsParameter3Selected, Mode=OneWay}"
                                            Command="{Binding ChangeTypingParameterCommand}"
                                            CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                                
                                <RadioButton Content="{Binding DisplayTypingParameter_4}"
                                            Style="{StaticResource selectformtyping}"
                                            Margin="0,0,8,0"
                                            IsChecked="{Binding IsParameter4Selected, Mode=OneWay}"
                                            Command="{Binding ChangeTypingParameterCommand}"
                                            CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                                
                                <RadioButton Content="✏️"
                                            Style="{StaticResource selectformtyping}"
                                            Command="{Binding ShowCustomParameterDialogCommand}"
                                            ToolTip="Custom value"/>
                            </StackPanel>
                        </Grid>
                        
                        <Popup x:Name="LanguagePopup" 
                               StaysOpen="False" 
                               Placement="Bottom" 
                               PlacementTarget="{Binding ElementName=LanguageSelector}"
                               AllowsTransparency="True">
                            <Border Background="{DynamicResource BgColorBrush}" 
                                    BorderBrush="{DynamicResource SubColorBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="0">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="1" 
                                                   BlurRadius="8" 
                                                   Color="#40000000" 
                                                   Opacity="0.2" 
                                                   Direction="270"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Padding="12,12,12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SubColorBrush}" Opacity="0.3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Text="🔍" 
                                                     Grid.Column="0"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     FontSize="12"
                                                     Foreground="{DynamicResource SubColorBrush}"/>
                                            
                                            <TextBox x:Name="LanguageSearchBox"
                                                    Grid.Column="1"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextColorBrush}"
                                                    BorderThickness="0"
                                                    FontFamily="Consolas"
                                                    FontSize="14"
                                                    TextChanged="LanguageSearchBox_TextChanged"
                                                    Padding="0,0,0,0"
                                                    TextWrapping="NoWrap"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    CaretBrush="{DynamicResource CaretColorBrush}">
                                                <TextBox.Resources>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="CornerRadius" Value="2"/>
                                                    </Style>
                                                </TextBox.Resources>
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <Grid>
                                                                        <TextBlock Text="Search language..." 
                                                                                Foreground="{DynamicResource SubColorBrush}"
                                                                                Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                VerticalAlignment="Center"/>
                                                                        <ScrollViewer x:Name="PART_ContentHost" 
                                                                                    Focusable="False"
                                                                                    HorizontalScrollBarVisibility="Hidden"
                                                                                    VerticalScrollBarVisibility="Hidden"/>
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                    </Border>
                                    
                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding FilteredLanguageNames}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="12,8"
                                                            Background="Transparent"
                                                            MouseEnter="LanguageItem_MouseEnter" 
                                                            MouseLeave="LanguageItem_MouseLeave"
                                                            MouseLeftButtonDown="LanguageItem_Click"
                                                            Cursor="Hand">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SubAltColorBrush}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding}" 
                                                                   Foreground="{DynamicResource TextColorBrush}" 
                                                                   FontFamily="Consolas" 
                                                                   FontSize="14"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        
        <Border Background="{DynamicResource SubAltColorBrush}" 
                Width="300" 
                Height="160"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                CornerRadius="10"
                BorderBrush="{DynamicResource SubColorBrush}"
                BorderThickness="1"
                x:Name="CustomParameterDialog"
                IsVisibleChanged="CustomParameterDialog_IsVisibleChanged"
                Panel.ZIndex="100">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CustomParameterDialogVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0"
                          Text="{Binding TypingTypeDisplay, StringFormat=Custom {0}}"
                          Foreground="{DynamicResource TextColorBrush}"
                          FontFamily="Consolas"
                          FontSize="18"
                          FontWeight="Bold"
                          Margin="15,15,15,10"
                          HorizontalAlignment="Center"/>
                
                <StackPanel Grid.Row="1" 
                            Orientation="Vertical" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                    <TextBlock Text="Enter a custom value:"
                              Foreground="{DynamicResource TextColorBrush}"
                              FontFamily="Consolas"
                              FontSize="14"
                              Margin="0,0,0,10"/>
                    <TextBox x:Name="CustomValueTextBox"
                            Text="{Binding CustomParameterValue, UpdateSourceTrigger=PropertyChanged}"
                            Width="100"
                            Height="30"
                            FontFamily="Consolas"
                            FontSize="16"
                            TextAlignment="Center"
                            Background="{DynamicResource SubAltColorBrush}"
                            Foreground="{DynamicResource TextColorBrush}"
                            BorderBrush="{DynamicResource SubColorBrush}"
                            BorderThickness="1"
                            PreviewTextInput="CustomValueTextBox_PreviewTextInput"
                            PreviewKeyDown="CustomValueTextBox_PreviewKeyDown"
                            CaretBrush="{DynamicResource CaretColorBrush}">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>
                
                <StackPanel Grid.Row="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            Margin="0,10,0,15">
                    <Button Content="Apply"
                            Width="100"
                            Height="30"
                            Margin="0,0,10,0"
                            Background="{DynamicResource MainColorBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding SetCustomParameterCommand}">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Cancel"
                            Width="100"
                            Height="30"
                            Background="{DynamicResource SubAltColorBrush}"
                            Foreground="{DynamicResource TextColorBrush}"
                            BorderBrush="{DynamicResource SubColorBrush}"
                            BorderThickness="1"
                            Command="{Binding CancelCustomParameterCommand}">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <Grid x:Name="IndicatorGrid" 
              VerticalAlignment="Center" 
              Margin="0,0,0,150">
            <TextBlock Text="{Binding ToolTipText}"
                       Visibility="Collapsed" />
        </Grid>
        <Grid x:Name="TextContainer"
              Height="115" 
              Margin="35,0,35,0" 
              VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayText}"
                       Style="{StaticResource InputText}"
                       FontSize="{Binding FontSizeText}" />
            <TextBox Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" 
                     FontSize="{Binding FontSizeText}" 
                     FontFamily="Consolas"
                     Style="{StaticResource inputtext}"
                     PreviewKeyDown="InputTextBox_PreviewKeyDown"
                     PreviewMouseLeftButtonDown="InputTextBox_PreviewMouseLeftButtonDown"
                     SelectionChanged="InputTextBox_SelectionChanged"
                     x:Name="InputTextBox" />
            <ItemsControl ItemsSource="{Binding ColoredUserInput}" 
                          VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                           x:Name="textBox"
                           Text="{Binding Character}" 
                           FontSize="{Binding FontSizeText}"
                           FontFamily="Consolas">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Incorrect">
                                            <Setter Property="Foreground" Value="Red" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Correct">
                                            <Setter Property="Foreground" Value="{DynamicResource CorrectTextColorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Missed">
                                            <Setter Property="Foreground" Value="#646669" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <Grid Margin="0,330,0,0">
            <Button Content="⟳" 
                    Style="{StaticResource DefaultStyle}"
                    Height="60"
                    Width="60"
                    FontSize="28"
                    Command="{Binding ResetTextCommand}">
            </Button>
        </Grid>
    </Grid>
</UserControl>
